# Copia este archivo a .env y llena los valores. El archivo .env NUNCA se sube a git.
PORT=4000
NODE_ENV=development

# Origen permitido para CORS (la web de React).
CORS_ORIGIN=http://localhost:5173

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bva_app
DB_PASSWORD=
DB_NAME=bva_saas

# JWT: secreto largo y aleatorio (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=bva-api
JWT_AUDIENCE=bva-web

# bcrypt: costo del hash. 12 es un buen equilibrio en 2026 (~250 ms por hash).
BCRYPT_ROUNDS=12

# MongoDB Atlas (base principal aprobada por el profesor Barry). Migración en curso:
# mientras tanto el código usa las variables DB_* de arriba.
MONGODB_URI=

# APIs externas (llaves secretas: solo en el servidor, nunca en VITE_*).
BCCR_TOKEN=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
# Open-Meteo no requiere llave en uso no comercial; el uso comercial exige plan de pago.

# WhatsApp Business y Meta (agente de redes sociales y de citas).
WHATSAPP_TOKEN=
META_APP_SECRET=
