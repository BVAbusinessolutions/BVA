# Variables públicas (VITE_*): llegan al navegador. Nunca pongas aquí llaves ni tokens secretos.

# Webhook de n8n que recibe el formulario de contacto. Vacío = en desarrollo el envío se simula.
VITE_CONTACT_WEBHOOK_URL=

# Datos de contacto que se muestran en el sitio (pie de página y /contacto).
VITE_CONTACT_EMAIL=hola@bva.cr
# WhatsApp: solo dígitos, con código de país (se usa para el enlace wa.me)
VITE_CONTACT_WHATSAPP=50688888888

# URL pública del sitio (SEO: enlaces canónicos y Open Graph). Sin barra final.
VITE_SITE_URL=
